<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#D8D2C8" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <item
        android:left="14dp"
        android:top="14dp"
        android:right="14dp"
        android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:type="linear"
                android:startColor="#4A90E2"
                android:centerColor="#6EA8F0"
                android:endColor="#4A90E2"
                android:useLevel="false" />
        </shape>
    </item>

    <item
        android:left="34dp"
        android:top="34dp"
        android:right="34dp"
        android:bottom="34dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

</layer-list>