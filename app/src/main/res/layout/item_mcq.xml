<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/mcqQuestionTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <Button
        android:id="@+id/mcqOption1Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option 1"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/mcqOption2Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option 2"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/mcqOption3Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option 3"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/mcqOption4Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Option 4"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/mcqResultTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:paddingTop="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mcqAnswerTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/mcqExplanationTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp" />
</LinearLayout>