<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <!-- Header like on Home screen -->
    <TextView
        android:id="@+id/historyHeaderTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Previous uploads"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/historySearchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:queryHint="Search uploads..."
        android:iconifiedByDefault="false"
        android:background="@android:color/transparent"
        android:layout_marginBottom="8dp" />

    <!-- Progress bar while loading -->
    <ProgressBar
        android:id="@+id/historyProgress"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <!-- Empty state text -->
    <TextView
        android:id="@+id/historyEmptyTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No uploads yet."
        android:gravity="center_horizontal"
        android:paddingVertical="8dp"
        android:visibility="gone" />

    <!-- RecyclerView with history items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp" />

</LinearLayout>
