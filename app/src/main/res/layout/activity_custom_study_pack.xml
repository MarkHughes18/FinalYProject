<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/customPackTitleTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Custom Study Pack"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/customPackSubtitleTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter at least 5 snippets for each study mode."
            android:textSize="14sp" />

        <EditText
            android:id="@+id/customPackNameET"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Custom pack title"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Flashcard snippets"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/flashcardSnippetsET"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Enter 5 snippets, one per line"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Cloze snippets"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/clozeSnippetsET"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Enter 5 snippets, one per line"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="True/False snippets"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/trueFalseSnippetsET"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Enter 5 snippets, one per line"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="MCQ snippets"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/mcqSnippetsET"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Enter 5 snippets, one per line"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <ProgressBar
            android:id="@+id/customPackProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/createCustomPackBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Create Study Pack" />

    </LinearLayout>
</ScrollView>