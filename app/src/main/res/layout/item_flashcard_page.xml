<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/flashcardOuterCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/flashcard_front_background"
        android:padding="34dp">

        <LinearLayout
            android:id="@+id/flashcardInnerPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/flashcardSideLabelTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Question"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/study_text_secondary"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/flashcardPageHintTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap card to reveal answer"
                android:textSize="14sp"
                android:textColor="@color/study_text_secondary"
                android:gravity="center"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/flashcardPageContentTV"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/study_text_primary"
                android:lineSpacingExtra="5dp" />

            <TextView
                android:id="@+id/flashcardSwipeHintTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Swipe for next card"
                android:textSize="13sp"
                android:textColor="@color/study_text_secondary"
                android:paddingTop="20dp" />

        </LinearLayout>
    </FrameLayout>

</FrameLayout>