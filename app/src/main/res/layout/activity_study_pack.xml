<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/studyPackTitleTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Study Pack"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/studyPackStatusTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="14sp"
        android:paddingBottom="12dp" />

    <ProgressBar
        android:id="@+id/studyPackProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/studyPackTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:fillViewport="false"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFlashcards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flashcards"
                android:backgroundTint="@color/study_blue"
                android:textColor="@android:color/white"/>

            <Button
                android:id="@+id/btnCloze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Cloze"
                android:backgroundTint="@color/study_blue"
                android:textColor="@android:color/white"/>
            />

            <Button
                android:id="@+id/btnTrueFalse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="True/False"
                android:backgroundTint="@color/study_blue"
                android:textColor="@android:color/white"/>
            />

            <Button
                android:id="@+id/btnMcq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="MCQ"
                android:backgroundTint="@color/study_blue"
                android:textColor="@android:color/white"/>
            />

            <Button
                android:id="@+id/btnMatching"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Matching"
                android:backgroundTint="@color/study_blue"
                android:textColor="@android:color/white"/>
            />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/studyPackRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>